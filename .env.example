# ---------------------------------------------------------------------
# NL2TRAPI (Streamlit) deployment env template
# ---------------------------------------------------------------------
# These paths are INSIDE the container. With docker-compose.yml, the host
# directory /data/nl2trapi is mounted as /data in the container.

# RENCI pred-mapping assets
RENCI_PRED_VECTORS=/data/data/all_biolink_mapped_vectors.json
RENCI_PRED_EMB_MODEL=/data/models/nomic-embed-text-v1.5

# Biolink YAML (adjust if your file is under /data/app/data/)
BIOLINK_YAML=/data/app/biolink-model.yaml

# Deterministic / CPU-only (no LLM)
NO_LLM=1
ALLOW_EMPTY_LLM=1

# Logging & noise control
LOGLEVEL=INFO
TRANSFORMERS_VERBOSITY=error
HF_HUB_DISABLE_PROGRESS_BARS=1
TOKENIZERS_PARALLELISM=false

# Optional offline flags (enable only after caching models)
#HF_HUB_OFFLINE=1
#TRANSFORMERS_OFFLINE=1
